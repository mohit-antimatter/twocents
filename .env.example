# Use a pooled PostgreSQL URL for the web app (the Neon hostname includes -pooler).
DATABASE_URL=postgresql://user:password@host-pooler.example/database?sslmode=require

# Use the direct URL for one-off schema/data imports.
DIRECT_DATABASE_URL=postgresql://user:password@host.example/database?sslmode=require

# Generate with: openssl rand -hex 32
RATE_LIMIT_SECRET=replace-with-a-random-secret

# Keep this small for serverless instances; the provider pool handles wider concurrency.
DATABASE_POOL_MAX=5
